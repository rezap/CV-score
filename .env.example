# Langfuse credentials (Project settings -> API keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# OpenAI API key (when provider: openai in cvscore.yaml)
# OPENAI_API_KEY=sk-...

# Optional: point at a non-default config file
# CVSCORE_CONFIG=./cvscore.yaml

# Entra ID with a service principal instead of `az login` / managed identity:
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...
